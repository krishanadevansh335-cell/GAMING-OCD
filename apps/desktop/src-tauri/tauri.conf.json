{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gaming Control Center",
  "version": "0.0.1",
  "identifier": "com.gcc.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GCC | Gaming Control Center",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": { "capabilities": ["default"] }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/krishanadevansh335-cell/GAMING-OCD-Releases/releases/latest/download/latest.json"],
      "pubkey": "PUBLIC_UPDATER_KEY_PLACEHOLDER"
    }
  }
}
