{
  "name": "gcc-workspace",
  "version": "0.0.1",
  "private": true,
  "description": "Gaming Control Center desktop foundation",
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "pnpm --filter desktop dev",
    "build": "pnpm --filter desktop build",
    "tauri": "pnpm --filter desktop tauri",
    "tauri:dev": "pnpm --filter desktop tauri dev",
    "tauri:build": "pnpm --filter desktop tauri build",
    "lint": "pnpm -r lint",
    "test": "cargo test --workspace"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
